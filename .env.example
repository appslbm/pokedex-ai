# Nenhuma variável é obrigatória. Não coloque segredos aqui: tudo que começa com VITE_
# vai para o JavaScript público. A Pokédex AI não usa chaves de API.

# Caminho base da publicação. No GitHub Pages é /<nome-do-repositório>/.
# O workflow de deploy define isto sozinho. Em domínio próprio, use /.
VITE_BASE_PATH=/pokedex-ai/

# Endereço de um manifest do modelo hospedado em outro lugar (opcional).
# VITE_MODEL_MANIFEST_URL=https://exemplo.com/pokedex-vision/manifest.json

# Sobe o servidor de desenvolvimento com HTTPS, para testar a câmera pelo celular na rede local.
# DEV_HTTPS=1
